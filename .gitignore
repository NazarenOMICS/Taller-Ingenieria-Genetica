# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Archivos temporales de Office ---
~$*
*.tmp

# --- Editores / IDE ---
.vscode/
.idea/
*.swp

# --- Entornos y dependencias ---
.venv/
venv/
__pycache__/
*.pyc
node_modules/

# --- Variables de entorno / secretos ---
.env
.env.*

# --- Logs ---
*.log

# --- Archivos de referencia pesados / descargas de investigacion (no versionar) ---
# Los .md derivados si se versionan; esto excluye binarios pesados sueltos en la raiz
# y en las carpetas de trabajo Search/ y Vault/ (PDFs de papers, datasets, secuencias).
*.pdf
*.dna
*.gb
*.xlsx
*.zip
Search/**/*.json
